# Krishi Mama — Frontend environment template
# Copy this file to .env.local and fill in values.
# NEVER put real secrets in this file or commit .env.local to Git.

# Base URL of the Krishi Mama backend REST API (no trailing slash)
# Also accepts NEXT_PUBLIC_API_URL as a backward-compatible alias
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
